{
    # Global options intentionally omitted: merge this snippet into the operator's
    # existing Caddy instance after validating both hosts and certificates.
}

pulsyr.dev {
    root * /srv/pulsyr/site
    encode zstd gzip

    header {
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    }

    @immutable path_regexp immutable ^/_astro/.*\.[A-Za-z0-9_-]{8,}\.(css|js)$
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    header /index.html Cache-Control "public, max-age=300, must-revalidate"

    try_files {path} {path}/
    file_server

    handle_errors {
        rewrite * /404.html
        file_server
    }
}

www.pulsyr.dev {
    redir https://pulsyr.dev{uri} permanent
}

app.pulsyr.dev {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000
}
