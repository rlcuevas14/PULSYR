---
import BrandMark from "./BrandMark.astro";
import { localeFromPath, localizedPath } from "../lib/i18n";
const locale = localeFromPath(Astro.url.pathname);
const isSpanish = locale === "es";
const local = (path: string) => localizedPath(path, locale);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={local("/")} aria-label={isSpanish ? "Inicio de Pulsyr" : "Pulsyr home"}><BrandMark size={26} /></a>
      <p>{isSpanish ? "El backlog que tu agente de código sí puede mantener." : "The backlog your coding agent can actually maintain."}</p>
      <p class="company">Avonlea Systems SpA · Santiago, Chile</p>
    </div>
    <div>
      <h2>{isSpanish ? "Producto" : "Product"}</h2>
      <a href={local("/producto/")}>{isSpanish ? "Características" : "Features"}</a>
      <a href={local("/integraciones/mcp/")}>{isSpanish ? "Integración MCP" : "MCP integration"}</a>
      <a data-analytics-event="cta_docs" href={local("/docs/primeros-pasos/")}>{isSpanish ? "Primeros pasos" : "Get started"}</a>
    </div>
    <div>
      <h2>{isSpanish ? "Proyecto" : "Project"}</h2>
      <a href={local("/open-source/")}>{isSpanish ? "Código abierto" : "Open source"}</a>
      <a href={local("/seguridad/")}>{isSpanish ? "Seguridad" : "Security"}</a>
      <a data-analytics-event="cta_github" href="https://github.com/rlcuevas14/PULSYR">GitHub</a>
    </div>
    <div>
      <h2>{isSpanish ? "Compañía" : "Company"}</h2>
      <a href={local("/contacto/")}>{isSpanish ? "Contacto" : "Contact"}</a>
      <a href={local("/privacidad/")}>{isSpanish ? "Privacidad" : "Privacy"}</a>
      <a href={local("/terminos/")}>{isSpanish ? "Términos" : "Terms"}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top:clamp(5rem,10vw,9rem); padding:4.5rem 0; border-top:1px solid var(--line); background:var(--soft); }
  .footer-grid { display:grid; grid-template-columns:2fr repeat(3,1fr); gap:2.5rem; }
  .footer-brand p { max-width:30rem; color:var(--muted); }
  .footer-brand a { text-decoration:none; }
  .company { font-size:.8rem; margin-top:1.5rem; }
  h2 { font-size:.78rem; letter-spacing:.1em; text-transform:uppercase; margin:0 0 1rem; }
  .footer-grid > div:not(.footer-brand) { display:flex; flex-direction:column; align-items:flex-start; gap:.7rem; }
  .footer-grid a { color:var(--body); text-decoration:none; font-size:.9rem; }
  .footer-grid a:hover { color:var(--ink); text-decoration:underline; text-underline-offset:3px; }
  @media (max-width:760px) { .footer-grid { grid-template-columns:1fr 1fr; } .footer-brand { grid-column:1/-1; } }
</style>
