---
interface Props {
  title?: string;
  body?: string;
}
const {
  title,
  body,
} = Astro.props;
const isSpanish = Astro.url.pathname === "/es" || Astro.url.pathname.startsWith("/es/");
const resolvedTitle = title ?? (isSpanish ? "Conecta tu primer proyecto sin configurar infraestructura." : "Connect your first project without configuring infrastructure.");
const resolvedBody = body ?? (isSpanish ? "El plan Gratuito incluye un proyecto, un colaborador, tres tokens MCP y 25 MB de documentos. Sin tarjeta." : "The Free plan includes one project, one teammate, three MCP tokens and 25 MB of documents. No card required.");
const docsPath = isSpanish ? "/es/docs/primeros-pasos/" : "/docs/primeros-pasos/";
---

<section class="container cta" aria-labelledby="cta-heading">
  <div>
    <p class="eyebrow">{isSpanish ? "Plan Gratuito" : "Free plan"}</p>
    <h2 id="cta-heading">{resolvedTitle}</h2>
    <p>{resolvedBody}</p>
  </div>
  <div class="actions">
    <a class="button button-light" data-analytics-event="cta_signup" href="https://app.pulsyr.dev/signup">{isSpanish ? "Comenzar gratis" : "Start free"}</a>
    <a class="button button-outline-on-dark" data-analytics-event="cta_docs" href={docsPath}>{isSpanish ? "Prefiero autohospedarlo" : "I prefer to self-host"}</a>
  </div>
</section>

<style>
  .cta { margin-top:5rem; border-radius:28px; padding:clamp(2rem,5vw,4.5rem); background:var(--teal); color:#fffaf0; display:flex; align-items:end; justify-content:space-between; gap:2rem; }
  .cta .eyebrow { color:var(--mint); }
  .cta h2 { margin:.45rem 0 .8rem; max-width:16ch; color:#fff; font-size:clamp(2rem,5vw,3.5rem); }
  .cta p { color:#d8e3df; max-width:620px; }
  .actions { flex-shrink:0; display:flex; flex-wrap:wrap; gap:.75rem; }
  @media (max-width:850px) { .cta { align-items:flex-start; flex-direction:column; } }
</style>
