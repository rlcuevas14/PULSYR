---
interface Props {
  title?: string;
  body?: string;
}
const {
  title,
  body,
} = Astro.props;
const isSpanish = Astro.url.pathname === "/es" || Astro.url.pathname.startsWith("/es/");
const resolvedTitle = title ?? (isSpanish ? "Dale a tu agente un backlog que pueda mantener actualizado." : "Give your agent a backlog it can keep current.");
const resolvedBody = body ?? (isSpanish ? "Aloja Pulsyr, crea un token de proyecto y conecta cualquier agente compatible con MCP." : "Self-host Pulsyr, create a project token, and connect any MCP-compatible coding agent.");
const docsPath = isSpanish ? "/es/docs/primeros-pasos/" : "/docs/primeros-pasos/";
---

<section class="container cta" aria-labelledby="cta-heading">
  <div>
    <p class="eyebrow">{isSpanish ? "Comienza en tu propia infraestructura" : "Start with your own infrastructure"}</p>
    <h2 id="cta-heading">{resolvedTitle}</h2>
    <p>{resolvedBody}</p>
  </div>
  <div class="actions">
    <a class="button button-light" data-analytics-event="cta_docs" href={docsPath}>{isSpanish ? "Lee la guía inicial" : "Read the quick start"}</a>
    <a class="button button-outline-on-dark" data-analytics-event="cta_github" href="https://github.com/rlcuevas14/PULSYR">{isSpanish ? "Ver en GitHub" : "View on GitHub"}</a>
  </div>
</section>

<style>
  .cta { margin-top:5rem; border-radius:28px; padding:clamp(2rem,5vw,4.5rem); background:var(--teal); color:#fffaf0; display:flex; align-items:end; justify-content:space-between; gap:2rem; }
  .cta .eyebrow { color:var(--mint); }
  .cta h2 { margin:.45rem 0 .8rem; max-width:16ch; color:#fff; font-size:clamp(2rem,5vw,3.5rem); }
  .cta p { color:#d8e3df; max-width:620px; }
  .actions { flex-shrink:0; display:flex; flex-wrap:wrap; gap:.75rem; }
  @media (max-width:850px) { .cta { align-items:flex-start; flex-direction:column; } }
</style>
