---
interface Props {
  src: string;
  poster: string;
  variant?: "hero" | "section";
}

const { src, poster, variant = "section" } = Astro.props;
---

<div class:list={["ambient-video", variant]} data-ambient-video aria-hidden="true">
  <video
    autoplay
    muted
    loop
    playsinline
    disablepictureinpicture
    preload="none"
    poster={poster}
    tabindex="-1"
  >
    <source src={src} type="video/mp4" />
  </video>
</div>

<style>
  .ambient-video { position:absolute; inset:0; z-index:0; overflow:hidden; pointer-events:none; background:var(--canvas); }
  .ambient-video::after { content:""; position:absolute; inset:0; }
  video { display:block; width:100%; height:100%; object-fit:cover; background:var(--canvas); }
  .hero video { object-position:center right; }
  .hero::after { background:linear-gradient(90deg,var(--canvas) 0%,rgb(255 250 240 / 96%) 37%,rgb(255 250 240 / 68%) 57%,rgb(255 250 240 / 14%) 82%),linear-gradient(0deg,rgb(255 250 240 / 28%),transparent 48%); }
  .section { background:#170b13; }
  .section video { object-position:center; filter:saturate(.8) contrast(1.08); }
  .section::after { background:linear-gradient(90deg,rgb(12 7 11 / 94%) 0%,rgb(18 8 14 / 76%) 48%,rgb(12 7 11 / 88%) 100%),linear-gradient(0deg,rgb(8 5 7 / 48%),transparent 45%,rgb(8 5 7 / 36%)); }
  @media(max-width:760px){
    .hero video { object-position:68% center; }
    .hero::after { background:linear-gradient(90deg,rgb(255 250 240 / 94%),rgb(255 250 240 / 82%)),linear-gradient(0deg,rgb(255 250 240 / 88%),transparent); }
    .section::after { background:rgb(12 7 11 / 84%); }
  }
  @media(prefers-reduced-motion:reduce){
    video { display:none; }
  }
</style>
