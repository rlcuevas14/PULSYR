---
import BrandMark from "./BrandMark.astro";
import { languageChoiceUrl, localeFromPath, localizedPath } from "../lib/i18n";

const path = Astro.url.pathname;
const locale = localeFromPath(path);
const isSpanish = locale === "es";
const links = (isSpanish ? [
  ["/producto/", "Producto"],
  ["/integraciones/mcp/", "Integración MCP"],
  ["/open-source/", "Código abierto"],
  ["/docs/primeros-pasos/", "Documentación"],
] : [
  ["/producto/", "Product"],
  ["/integraciones/mcp/", "MCP integration"],
  ["/open-source/", "Open source"],
  ["/docs/primeros-pasos/", "Docs"],
]).map(([href, label]) => [localizedPath(href, locale), label]);
const englishChoice = languageChoiceUrl("en", path);
const spanishChoice = languageChoiceUrl("es", path);
---

<header class="site-header">
  <nav class="container nav" aria-label={isSpanish ? "Navegación principal" : "Primary navigation"}>
    <a class="logo-link" href={localizedPath("/", locale)} aria-label={isSpanish ? "Inicio de Pulsyr" : "Pulsyr home"}><BrandMark /></a>
    <div class="desktop-links">
      {links.map(([href, label]) => (
        <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>
      ))}
    </div>
    <div class="desktop-actions">
      <a class="text-link" data-analytics-event="cta_github" href="https://github.com/rlcuevas14/PULSYR">GitHub</a>
      <details class="language-menu">
        <summary aria-label={isSpanish ? "Seleccionar idioma" : "Select language"}><span aria-hidden="true">◎</span> {locale.toUpperCase()}</summary>
        <div class="language-panel">
          <a href={englishChoice} lang="en" aria-current={locale === "en" ? "true" : undefined}>English</a>
          <a href={spanishChoice} lang="es" aria-current={locale === "es" ? "true" : undefined}>Español</a>
        </div>
      </details>
      <a class="button button-dark button-small" data-analytics-event="cta_app" href="https://app.pulsyr.dev/login">{isSpanish ? "Abrir la aplicación" : "Open the app"}</a>
    </div>
    <details class="mobile-menu">
      <summary aria-label={isSpanish ? "Abrir navegación" : "Open navigation"}>{isSpanish ? "Menú" : "Menu"}</summary>
      <div class="mobile-panel">
        {links.map(([href, label]) => <a href={href}>{label}</a>)}
        <a data-analytics-event="cta_github" href="https://github.com/rlcuevas14/PULSYR">GitHub</a>
        <div class="mobile-languages" role="group" aria-label={isSpanish ? "Seleccionar idioma" : "Select language"}>
          <a href={englishChoice} lang="en" aria-current={locale === "en" ? "true" : undefined}>EN</a>
          <a href={spanishChoice} lang="es" aria-current={locale === "es" ? "true" : undefined}>ES</a>
        </div>
        <a data-analytics-event="cta_app" href="https://app.pulsyr.dev/login">{isSpanish ? "Abrir la aplicación" : "Open the app"}</a>
      </div>
    </details>
  </nav>
</header>

<style>
  .site-header { position:sticky; top:0; z-index:20; background:color-mix(in srgb, var(--canvas) 92%, transparent); border-bottom:1px solid var(--line); backdrop-filter:blur(14px); }
  .nav { min-height:68px; display:flex; align-items:center; gap:2rem; }
  .logo-link { text-decoration:none; margin-right:auto; }
  .desktop-links,.desktop-actions { display:flex; align-items:center; gap:1.25rem; }
  .desktop-links a,.text-link { color:var(--muted); font-size:.9rem; font-weight:600; text-decoration:none; }
  .desktop-links a:hover,.desktop-links a[aria-current="page"],.text-link:hover { color:var(--ink); }
  .mobile-menu { display:none; position:relative; }
  .mobile-menu summary { cursor:pointer; list-style:none; min-height:44px; display:flex; align-items:center; padding:0 1rem; border:1px solid var(--line); border-radius:12px; font-weight:700; }
  .mobile-menu summary::-webkit-details-marker { display:none; }
  .language-menu { position:relative; }
  .language-menu summary { cursor:pointer; list-style:none; display:flex; align-items:center; gap:.35rem; min-height:44px; color:var(--muted); font-size:.82rem; font-weight:750; }
  .language-menu summary::-webkit-details-marker { display:none; }
  .language-panel { position:absolute; right:0; top:calc(100% + .5rem); min-width:145px; padding:.45rem; display:grid; background:var(--canvas); border:1px solid var(--line); border-radius:13px; box-shadow:var(--shadow); }
  .language-panel a { padding:.7rem .8rem; border-radius:9px; color:var(--body); text-decoration:none; font-size:.88rem; }
  .language-panel a:hover { background:var(--soft); }
  .language-panel a[aria-current="true"] { background:var(--soft); color:var(--ink); font-weight:750; }
  .mobile-panel { position:absolute; right:0; top:calc(100% + .6rem); width:min(82vw,280px); padding:.6rem; display:grid; background:var(--canvas); border:1px solid var(--line); border-radius:16px; box-shadow:var(--shadow); }
  .mobile-panel a { color:var(--ink); text-decoration:none; padding:.85rem; border-radius:10px; }
  .mobile-panel a:hover { background:var(--soft); }
  .mobile-languages { display:flex; gap:.45rem; padding:.65rem .85rem; border-block:1px solid var(--line); }
  .mobile-languages a { min-width:44px; padding:.45rem .7rem; text-align:center; border:1px solid var(--line); }
  .mobile-languages a[aria-current="true"] { color:var(--canvas); background:var(--ink); border-color:var(--ink); }
  @media (max-width:900px) { .desktop-links,.desktop-actions { display:none; } .mobile-menu { display:block; } }
</style>
