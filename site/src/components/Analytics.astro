---
const deployment = import.meta.env.PUBLIC_DEPLOYMENT_ENVIRONMENT || "development";
const enabled = import.meta.env.PUBLIC_ANALYTICS_ENABLED === "true" && deployment === "production";
const domain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN || "pulsyr.dev";
---

{enabled && (
  <>
    <script is:inline defer src="/analytics.js"></script>
    <script is:inline defer data-domain={domain} src="https://plausible.io/js/script.js"></script>
  </>
)}
