---
import PageHero from "../../components/PageHero.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
---

<PublicLayout title="Contact" description="Choose the right public or private channel for Pulsyr product questions, bug reports, security vulnerabilities, legal matters, and contributions.">
  <PageHero eyebrow="Contact" title="Send the question to the channel that can act on it." lead="Pulsyr is a solo-maintained open-source project. Public product discussion belongs on GitHub; security reports use private advisories; legal and trademark questions use email." />
  <section class="section-tight container">
    <div class="grid-3">
      <article class="contact-card card lavender"><span class="kicker">Public</span><h2>Bugs and feature ideas</h2><p>Search existing issues first, then open a focused report with context and reproducible steps.</p><a class="button button-dark" href="https://github.com/rlcuevas14/PULSYR/issues">GitHub Issues</a></article>
      <article class="contact-card card teal"><span class="kicker">Private</span><h2>Security vulnerability</h2><p>Do not disclose a vulnerability in an issue. Send it through GitHub's private advisory workflow.</p><a class="button button-light" href="https://github.com/rlcuevas14/PULSYR/security/advisories/new">Report privately</a></article>
      <article class="contact-card card peach"><span class="kicker">Email</span><h2>Legal and trademarks</h2><p>Ask about brand permission, licensing interpretation, or this website's legal notices.</p><a class="button button-dark" href="mailto:legal@pulsyr.dev">legal@pulsyr.dev</a></article>
    </div>
  </section>
</PublicLayout>

<style>.contact-card{display:flex;flex-direction:column;align-items:flex-start}.contact-card h2{margin-top:1.7rem;font-size:1.6rem}.contact-card .button{margin-top:auto}.contact-card p{margin-bottom:1.5rem}</style>
