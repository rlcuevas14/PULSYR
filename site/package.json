{
  "name": "pulsyr-public-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "build": "astro build",
    "check": "astro check",
    "build:app": "tailwindcss -c tailwind.app.config.mjs -i app-assets/tailwind.css -o ../app/static/.build/app.css --minify && node scripts/hash-app-assets.mjs",
    "test:e2e": "playwright test tests/e2e/public-site.spec.ts",
    "test:private-ui": "playwright test tests/e2e/private-ui-behavior.spec.ts",
    "test:browsers": "playwright test tests/e2e/cross-browser.spec.ts",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:lighthouse": "node scripts/check-lighthouse-reports.mjs",
    "check:budget": "node scripts/check-performance-budget.mjs"
  },
  "dependencies": {
    "astro": "7.2.1",
    "htmx.org": "2.0.10",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "html-validate": "11.6.2",
    "lighthouse": "13.4.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  }
}
