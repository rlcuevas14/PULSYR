# Required
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Startup ABORTS in production (DEBUG=false) if SECRET_KEY is a known placeholder
# or shorter than 32 characters.
SECRET_KEY=change-me

# Required: must match the password in docker-compose.yml
DB_PASSWORD=change-me

# Optional, but required for OAuth: the public URL of this instance. The OAuth
# callback is derived from it, and the provider rejects a mismatch.
# BASE_URL=https://pulsyr.example.com

# Optional - sign in with GitHub or Google. With no keys set, the buttons never
# render and the password form is the only way in, so leaving this empty changes
# nothing. Register the callback as BASE_URL + /callback/github (or /callback/google).
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# Optional - let anyone with a provider account register themselves. Off by
# default: being reachable on the internet is not a reason to accept strangers
# into your backlog. Requires at least one OAuth provider above.
# PUBLIC_SIGNUP=false
# Hosted Free plan limits (ignored by self-hosted subscriptions)
# FREE_MAX_PROJECTS=1
# FREE_MAX_MEMBERS=1
# FREE_MAX_TOKENS_PER_PROJECT=3
# FREE_MAX_STORAGE_MB=25
# OAuth abuse protection per client and fixed window
# OAUTH_RATE_LIMIT_ATTEMPTS=20
# OAUTH_RATE_LIMIT_WINDOW_SECONDS=600
# Shared database-backed limits work across application replicas. Password login
# combines a broad client-IP budget with a tighter identity budget for failures.
# PASSWORD_RATE_LIMIT_ATTEMPTS=10
# PASSWORD_IP_RATE_LIMIT_ATTEMPTS=100
# WEBHOOK_RATE_LIMIT_ATTEMPTS=600
# MCP_RATE_LIMIT_ATTEMPTS=600
# MACHINE_RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_RETENTION_SECONDS=86400
# RATE_LIMIT_PRUNE_INTERVAL_SECONDS=3600
# Trust forwarded visitor addresses only from directly connected proxy CIDRs.
# Leave empty when Uvicorn is internet-facing. Example Docker bridge: 172.16.0.0/12
# TRUSTED_PROXY_CIDRS=
# HTTP body ceilings. Multipart upload includes boundary/form overhead over the
# application's 10 MB deliverable limit.
# REQUEST_MAX_BODY_BYTES=2097152
# WEBHOOK_MAX_BODY_BYTES=1048576
# MCP_MAX_BODY_BYTES=1048576
# UPLOAD_MAX_BODY_BYTES=11534336
# Version recorded with signup consent; bump when legal acceptance must be renewed
# TERMS_VERSION=2026-08-12

# Optional: AI enrichment (impact/effort scoring + semantic search)
# Both degrade gracefully if absent: no errors, enrichment is simply skipped.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: GitHub container registry owner (used in docker-compose image tag)
# GITHUB_OWNER=your-github-username

# Optional: host port and image tag used by docker-compose.yml
# PORT=8000
# IMAGE_TAG=latest

# Runtime identity and optional privacy-conscious application monitoring.
# DEPLOYMENT_ENVIRONMENT=production
# RELEASE=<git-sha-or-image-digest>
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# READINESS_TIMEOUT_SECONDS=2.0
# Optional protected Prometheus scrape. Disabled when empty; use a distinct
# random secret of at least 32 characters and never reuse SECRET_KEY.
# METRICS_BEARER_TOKEN=

# Public-site build only. Analytics renders only when both switches explicitly
# identify production; keep disabled for local/staging builds.
# PUBLIC_DEPLOYMENT_ENVIRONMENT=production
# PUBLIC_ANALYTICS_ENABLED=false
# PUBLIC_ANALYTICS_DOMAIN=pulsyr.dev
# PUBLIC_GOOGLE_SITE_VERIFICATION=
# PUBLIC_BING_SITE_VERIFICATION=

# Optional: full DB URL override (when running without docker-compose)
# DATABASE_URL=postgresql+asyncpg://pulso:password@localhost:5432/pulso
# Bounded PostgreSQL pool and query execution. Tune pool size against the database
# connection budget across every application replica.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_STATEMENT_TIMEOUT_SECONDS=30

# Optional: webhook integration secrets (configured per-project in the UI in a future release)
# GITHUB_WEBHOOK_SECRET=
# SENTRY_CLIENT_SECRET=
# SENTRY_API_TOKEN=
# SENTRY_ORG=

# Optional: hosted billing (Paddle). Self-hosted installs leave these empty: with no
# secret the billing webhook answers 503 and no paid plan can ever be granted.
# The secret belongs to ONE notification destination. Sandbox and live have separate
# destinations with separate secrets, and mixing them fails every signature check.
# PADDLE_WEBHOOK_SECRET=

# Advanced
# JOB_POLL_INTERVAL_SECONDS=10
# JOB_LEASE_SECONDS=300
# Bounded worker concurrency and per-project pending/running queue capacity.
# Each active job consumes one database connection while its handler runs.
# JOB_CONCURRENCY=2
# JOB_QUEUE_MAX_ACTIVE=1000
# DEBUG=false
