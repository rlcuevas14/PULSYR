# Copy to a secret-managed location outside the repository. Never reuse production
# credentials, OAuth apps, databases, monitoring DSNs or analytics configuration.
SECRET_KEY=change-me
DB_PASSWORD=generate-a-unique-staging-database-password
BASE_URL=https://app-staging.pulsyr.dev
DEPLOYMENT_ENVIRONMENT=staging
RELEASE=git-sha-or-image-digest
DEBUG=false
PUBLIC_SIGNUP=false

# An immutable image reference is mandatory. Tags such as latest are rejected by
# the release verifier and are not suitable for promotion.
PULSYR_IMAGE=ghcr.io/rlcuevas14/pulsyr@sha256:replace-with-64-hex-characters
STAGING_PORT=18000

# Register separate staging OAuth applications if OAuth is exercised.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Separate monitoring project; analytics stays disabled on staging.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
